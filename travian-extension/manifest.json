{
  "manifest_version": 3,
  "name": "مساعد ترافيان",
  "version": "1.2.0",
  "description": "يراقب قراك في ترافيان ويرسل لك تنبيهات عند الهجمات وامتلاء المخازن، ويدير قائمة البناء وتدريب القوات وقوائم المزارع ومغامرات البطل أثناء غيابك.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.travian.com/*",
    "https://api.telegram.org/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.travian.com/*"
      ],
      "js": [
        "src/parser.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "مساعد ترافيان",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
