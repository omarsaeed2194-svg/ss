{
  "manifest_version": 3,
  "name": "Travian Helper",
  "version": "1.0.0",
  "description": "Keeps an eye on your Travian Legends villages, alerts you about attacks and full storage, and runs your build queue, troop training, farm lists and hero adventures while you're away.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://*.travian.com/*",
    "https://api.telegram.org/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.travian.com/*"],
      "js": ["src/parser.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Travian Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
