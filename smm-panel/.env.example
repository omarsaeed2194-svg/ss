# --- Admin account ---
# On startup, an admin account (username "admin") is created for this email if
# no account uses it yet. An existing customer account with this email is never
# promoted, because sign-up doesn't verify emails.
# The password is only used when the account is first created; change it
# afterwards from Account → Password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database ---
# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, your own server...).
# Leave empty to use an embedded Postgres (PGlite) stored in ./data/pglite —
# great for local development and single-server hosting, but NOT for
# serverless hosts like Vercel (their filesystem is not persistent).
DATABASE_URL=

# --- Background order sync ---
# Secret for GET/POST /api/cron/sync, which pulls order and refill statuses
# from your providers. Call it every few minutes from a scheduler with
#   Authorization: Bearer <CRON_SECRET>     (Vercel Cron sends this automatically)
# or ?secret=<CRON_SECRET>. Generate one with: openssl rand -hex 32
CRON_SECRET=
