# Password for the /admin backend. Required — the admin is locked until it's set.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Optional: persistent storage for serverless hosts (Vercel etc.) ---
# Without these, content is saved to data/site.json on disk, which works for
# `npm run dev` / any Node host with a writable disk, but NOT on Vercel
# (read-only filesystem). Create a free Upstash Redis database (or Vercel KV,
# which is Upstash under the hood) and paste its REST URL + token here.
KV_REST_API_URL=
KV_REST_API_TOKEN=
