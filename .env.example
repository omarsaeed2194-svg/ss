# Domain shown in the dashboard header (defaults to localization.saudisoft.com)
TARGET_DOMAIN=localization.saudisoft.com

# --- Google Analytics 4 (GA4 Data API) ---
# Property ID for localization.saudisoft.com, e.g. "properties/123456789" -> use just the number
GA4_PROPERTY_ID=123456789

# --- Google Search Console (Search Console API) ---
# Exact property as verified in Search Console, e.g. "https://localization.saudisoft.com/"
# or "sc-domain:saudisoft.com" for a domain-property.
GSC_SITE_URL=https://localization.saudisoft.com/

# --- Shared Google service account (used by both GA4 and Search Console) ---
# Create a service account in Google Cloud Console, enable the "Google Analytics Data API"
# and "Search Console API", then add the service account email as:
#   - a Viewer on the GA4 property (Admin > Property Access Management)
#   - a Full/Restricted user on the Search Console property (Settings > Users and permissions)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON key, keeping the \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
